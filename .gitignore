# ── VerificaPE · .gitignore raíz ─────────────────────────────
# Sube este repositorio a GitHub con confianza: los secretos y
# binarios generados quedan fuera del control de versiones.

android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/notibridge.keystore
*.keystore
*.jks

# Web · dependencias, base de datos local y secretos
web/node_modules/
web/data/
web/.env
web/cloudflared/

# Binarios de distribución (usa GitHub Releases para las APK)
dist/

# Sistema operativo / IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
